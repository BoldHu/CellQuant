{
  "schema_version": "1.0",
  "created_date": "2026-11-15",
  "purpose": "预注册项目投入门槛，不是会议录用标准；初始结果不得伪填",
  "missing_policy": "INSUFFICIENT_EVIDENCE",
  "allowed_comparators": [
    "ge",
    "le",
    "eq"
  ],
  "decision_semantics": "common_checks全部通过，且至少一个route全部通过；source_type须允许；缺失不视为通过",
  "gates": [
    {
      "gate_id": "G0",
      "title": "数学与CPU参考正确性",
      "on_pass": "real_layer_pilot",
      "allowed_source_types": [
        "synthetic_math",
        "measured_cpu",
        "measured_gpu"
      ],
      "common_checks": [
        {
          "metric": "math_seed_count",
          "op": "ge",
          "value": 3,
          "unit": "count",
          "rationale": "覆盖校准构造的随机性"
        },
        {
          "metric": "math_case_count",
          "op": "ge",
          "value": 20,
          "unit": "count",
          "rationale": "不同形状、分组、边界和更新方向"
        },
        {
          "metric": "fp64_product_rel_error_max",
          "op": "le",
          "value": 1e-10,
          "unit": "ratio",
          "rationale": "||WQ^TQX-WX||F / max(||WX||F,1e-12)"
        },
        {
          "metric": "fp64_orthogonality_rel_error_max",
          "op": "le",
          "value": 1e-10,
          "unit": "ratio",
          "rationale": "||Q^TQ-I||F/sqrt(d)"
        },
        {
          "metric": "cell_loss_prediction_abs_error_max",
          "op": "le",
          "value": 1e-09,
          "unit": "normalized_loss",
          "rationale": "解析胞元系数与直接量化一致"
        },
        {
          "metric": "screened_vs_full_loss_rel_error_max",
          "op": "le",
          "value": 1e-07,
          "unit": "ratio",
          "rationale": "有平坦最优集时比较损失而非角度"
        },
        {
          "metric": "budget_violation_count",
          "op": "eq",
          "value": 0,
          "unit": "count",
          "rationale": "容差应预先固定"
        },
        {
          "metric": "accepted_update_increase_count",
          "op": "eq",
          "value": 0,
          "unit": "count",
          "rationale": "实际量化器验证后才接受"
        },
        {
          "metric": "rounding_boundary_cases_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "覆盖实际边界和同时事件"
        },
        {
          "metric": "input_output_direction_cases_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "分别覆盖WQ^T/QX和QB"
        }
      ],
      "routes": {
        "correctness": [
          {
            "metric": "reference_implementation_audited",
            "op": "eq",
            "value": true,
            "unit": "boolean",
            "rationale": "数值根不等于形式化认证"
          }
        ]
      }
    },
    {
      "gate_id": "G1",
      "title": "Colab真实层潜力",
      "on_pass": "autodl_limited_canary",
      "allowed_source_types": [
        "real_layer",
        "measured_gpu"
      ],
      "common_checks": [
        {
          "metric": "g0_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "读取真实G0报告"
        },
        {
          "metric": "real_panel_provenance_verified",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "真实模型、token及矩阵来源可追溯"
        },
        {
          "metric": "real_model_parameter_billions",
          "op": "ge",
          "value": 6.5,
          "unit": "billion",
          "rationale": "小模型smoke不能代替7B目标"
        },
        {
          "metric": "calibration_seed_count",
          "op": "ge",
          "value": 2,
          "unit": "count",
          "rationale": "不是将多个token当独立seed"
        },
        {
          "metric": "layer_count",
          "op": "ge",
          "value": 3,
          "unit": "count",
          "rationale": "早、中、晚层"
        },
        {
          "metric": "site_count",
          "op": "ge",
          "value": 9,
          "unit": "count",
          "rationale": "3层×q/up/down"
        },
        {
          "metric": "fit_sequence_count",
          "op": "ge",
          "value": 8,
          "unit": "count",
          "rationale": "可抽token但需完整上下文来源"
        },
        {
          "metric": "heldout_sequence_count",
          "op": "ge",
          "value": 8,
          "unit": "count",
          "rationale": "独立序列验证"
        },
        {
          "metric": "calibration_heldout_disjoint",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不调最终测试集"
        },
        {
          "metric": "shared_global_r1",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "所有位置必须同一Q"
        },
        {
          "metric": "full_quant_groups_preserved",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不能截断组后重新算scale"
        },
        {
          "metric": "down_projection_output_side_correct",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "down路径按QB处理"
        },
        {
          "metric": "matched_solver_controls_complete",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "STE、网格、固定尺度并保持同目标/参数/时间预算"
        },
        {
          "metric": "same_hardware_timing",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "禁止比较Colab与AutoDL秒数声称算法加速"
        },
        {
          "metric": "each_seed_pooled_heldout_improved",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不靠单seed掩盖另一个失败"
        },
        {
          "metric": "max_site_nmse_regression_vs_best_pct",
          "op": "le",
          "value": 10,
          "unit": "percent",
          "rationale": "任何位置不能严重退化"
        }
      ],
      "routes": {
        "accuracy": [
          {
            "metric": "median_nmse_gain_vs_hadamard_pct",
            "op": "ge",
            "value": 10,
            "unit": "percent",
            "rationale": "真实held-out误差，而非crest"
          },
          {
            "metric": "median_nmse_gain_vs_best_matched_solver_pct",
            "op": "ge",
            "value": 5,
            "unit": "percent",
            "rationale": "避免仅赢固定Hadamard"
          },
          {
            "metric": "site_win_fraction_vs_best_matched_solver",
            "op": "ge",
            "value": 0.6666666666666666,
            "unit": "fraction",
            "rationale": "至少6/9位置"
          }
        ],
        "efficiency": [
          {
            "metric": "median_nmse_gain_vs_hadamard_pct",
            "op": "ge",
            "value": 5,
            "unit": "percent",
            "rationale": "确有量化收益"
          },
          {
            "metric": "median_nmse_regression_vs_best_matched_solver_pct",
            "op": "le",
            "value": 2,
            "unit": "percent",
            "rationale": "探索性非劣幅度"
          },
          {
            "metric": "site_noninferior_fraction_at_2pct",
            "op": "ge",
            "value": 0.6666666666666666,
            "unit": "fraction",
            "rationale": "至少6/9位置在2%范围内"
          },
          {
            "metric": "pilot_calibration_speedup",
            "op": "ge",
            "value": 2,
            "unit": "ratio",
            "rationale": "完整pilot校准含事件构造/排序/求根/复核"
          }
        ]
      }
    },
    {
      "gate_id": "G2",
      "title": "AutoDL完整模型canary",
      "on_pass": "prepare_full_protocol",
      "allowed_source_types": [
        "real_model",
        "measured_gpu"
      ],
      "common_checks": [
        {
          "metric": "g1_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "硬件probe不能冒充G1通过"
        },
        {
          "metric": "full_precision_model_equivalence_checked",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "原始/合法Norm融合/旋转三路检查"
        },
        {
          "metric": "fp32_logits_relative_rms_error",
          "op": "le",
          "value": 0.0001,
          "unit": "ratio",
          "rationale": "同attention后端和输入"
        },
        {
          "metric": "fp32_mean_nll_abs_difference",
          "op": "le",
          "value": 0.0001,
          "unit": "nats_per_token",
          "rationale": "量化关闭时的等价检查"
        },
        {
          "metric": "rmsnorm_embedding_centering_disabled",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "目标LLaMA不使用不等价中心化"
        },
        {
          "metric": "rotation_checkpoint_schema_valid",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "R1=Q.T且所有R2键齐全"
        },
        {
          "metric": "canonical_model_id",
          "op": "eq",
          "value": "meta-llama/Llama-2-7b-hf",
          "unit": "model_id",
          "rationale": "首个完整模型canary"
        },
        {
          "metric": "quantization_setting",
          "op": "eq",
          "value": "W4A4KV4",
          "unit": "format",
          "rationale": "最终采用GPTQ权重和指定激活/KV规则"
        },
        {
          "metric": "calibration_seed_count",
          "op": "ge",
          "value": 2,
          "unit": "count",
          "rationale": "独立校准重复"
        },
        {
          "metric": "calibration_sequences",
          "op": "eq",
          "value": 128,
          "unit": "count",
          "rationale": "与预注册canary一致"
        },
        {
          "metric": "calibration_sequence_length",
          "op": "eq",
          "value": 2048,
          "unit": "tokens",
          "rationale": "不能默默换上下文"
        },
        {
          "metric": "development_only_evaluation",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不得以最终测试集反复调参"
        },
        {
          "metric": "matched_spinquant_reproduction_present",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不能用外部论文数值或仅R1控制版冒充完整基线"
        },
        {
          "metric": "gptq_pipeline_completed",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "RTN结果不足以过此阶段"
        },
        {
          "metric": "gptq_transfer_observed",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "直接测量完整模型而非从局部推断"
        }
      ],
      "routes": {
        "accuracy": [
          {
            "metric": "dev_ppl_gain_vs_hadamard_pct",
            "op": "ge",
            "value": 2,
            "unit": "percent",
            "rationale": "按平均NLL计算PPL"
          },
          {
            "metric": "max_seed_dev_ppl_regression_vs_spinquant_pct",
            "op": "le",
            "value": 0.5,
            "unit": "percent",
            "rationale": "两个seed都满足"
          }
        ],
        "efficiency": [
          {
            "metric": "max_seed_dev_ppl_regression_vs_spinquant_pct",
            "op": "le",
            "value": 1,
            "unit": "percent",
            "rationale": "两个seed都满足"
          },
          {
            "metric": "total_calibration_speedup_vs_spinquant",
            "op": "ge",
            "value": 2,
            "unit": "ratio",
            "rationale": "capture+rotation+fusion+GPTQ，同硬件精度"
          }
        ]
      }
    },
    {
      "gate_id": "G3",
      "title": "完整实验运行就绪",
      "on_pass": "full_experiment_matrix",
      "allowed_source_types": [
        "real_model",
        "measured_gpu"
      ],
      "common_checks": [
        {
          "metric": "g2_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "仅在完整canary通过后扩展"
        },
        {
          "metric": "target_gpu_identity_verified",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "按实际device及MIG状态核实"
        },
        {
          "metric": "visible_gpu_memory_gib",
          "op": "ge",
          "value": 80,
          "unit": "GiB",
          "rationale": "96GB整卡目标；分区卡须重新做资源方案"
        },
        {
          "metric": "cuda_gemm_smoke_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "真实目标GPU计算，不只是import"
        },
        {
          "metric": "fht_backend_numeric_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "包括实际模型维度"
        },
        {
          "metric": "calibration_peak_to_visible_memory_ratio",
          "op": "le",
          "value": 0.85,
          "unit": "fraction",
          "rationale": "保留至少15%余量"
        },
        {
          "metric": "interrupt_resume_equivalence_pass",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "中断恢复与连续执行一致"
        },
        {
          "metric": "artifact_hashes_verified",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "模型分片/数据/配置/代码哈希"
        },
        {
          "metric": "protocol_frozen",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "方法、种子、校准与评估规则锁定"
        },
        {
          "metric": "budget_plan_based_on_measurements",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "基于canary阶段实测估计GPU小时"
        },
        {
          "metric": "final_test_tuning_count",
          "op": "eq",
          "value": 0,
          "unit": "count",
          "rationale": "最终测试集不作开发反馈"
        }
      ],
      "routes": {
        "full_experiment": [
          {
            "metric": "complete_run_manifest_written",
            "op": "eq",
            "value": true,
            "unit": "boolean",
            "rationale": "所有待运行项与预算已落盘"
          }
        ]
      }
    },
    {
      "gate_id": "G4",
      "title": "完整方法论文候选",
      "on_pass": "paper_candidate_not_acceptance",
      "allowed_source_types": [
        "real_model",
        "measured_gpu"
      ],
      "common_checks": [
        {
          "metric": "main_model_count",
          "op": "ge",
          "value": 2,
          "unit": "count",
          "rationale": "LLaMA2-7B和原始LLaMA3-8B"
        },
        {
          "metric": "main_model_ids_correct",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "不混用Llama3.1/3.2/Instruct"
        },
        {
          "metric": "min_calibration_seed_count",
          "op": "ge",
          "value": 3,
          "unit": "count",
          "rationale": "每个主模型方法组合"
        },
        {
          "metric": "ppl_model_dataset_cell_count",
          "op": "ge",
          "value": 4,
          "unit": "count",
          "rationale": "两个模型各Wiki/C4"
        },
        {
          "metric": "zero_shot_task_count",
          "op": "ge",
          "value": 6,
          "unit": "count",
          "rationale": "固定任务及acc/acc_norm键"
        },
        {
          "metric": "recent_2026_baseline_reproduced_count",
          "op": "ge",
          "value": 1,
          "unit": "count",
          "rationale": "至少一个较新的公开方法"
        },
        {
          "metric": "matched_solver_controls_complete",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "同参数同目标同预算控制"
        },
        {
          "metric": "strongest_baseline_selection_frozen",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "最强竞争者选择规则预先确定"
        },
        {
          "metric": "paired_ci_method_valid",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "按文档/序列及校准seed处理依赖"
        },
        {
          "metric": "core_ablation_count",
          "op": "ge",
          "value": 5,
          "unit": "count",
          "rationale": "目标、尺度、交叉项、预算、筛选/增量"
        },
        {
          "metric": "novelty_audit_updated",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "更新到写稿时点，排查邻近工作新版本"
        },
        {
          "metric": "theorem_scope_audited",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "RTN/固定面板/一维范围清楚"
        },
        {
          "metric": "paper_results_separated_from_own_runs",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "引用数值单独表"
        },
        {
          "metric": "extra_online_r1_ops",
          "op": "eq",
          "value": 0,
          "unit": "count",
          "rationale": "R1应融合"
        },
        {
          "metric": "performance_claims_match_backend",
          "op": "eq",
          "value": true,
          "unit": "boolean",
          "rationale": "fake quant不宣称真实INT4吞吐"
        }
      ],
      "routes": {
        "accuracy": [
          {
            "metric": "pooled_geomean_ppl_gain_pct",
            "op": "ge",
            "value": 1,
            "unit": "percent",
            "rationale": "四格log-PPL等权"
          },
          {
            "metric": "min_model_mean_ppl_gain_pct",
            "op": "ge",
            "value": 0.5,
            "unit": "percent",
            "rationale": "每个模型都有收益"
          },
          {
            "metric": "max_ppl_cell_regression_pct",
            "op": "le",
            "value": 0.5,
            "unit": "percent",
            "rationale": "不能用平均隐藏明显退化"
          },
          {
            "metric": "pooled_nll_delta_ci95_high",
            "op": "le",
            "value": 0,
            "unit": "nats_per_token",
            "rationale": "new-baseline的paired CI"
          },
          {
            "metric": "mean_task_accuracy_gain_pp",
            "op": "ge",
            "value": 0.5,
            "unit": "percentage_points",
            "rationale": "不是相对百分比"
          },
          {
            "metric": "mean_task_accuracy_delta_ci95_low_pp",
            "op": "ge",
            "value": 0,
            "unit": "percentage_points",
            "rationale": "paired task CI"
          }
        ],
        "efficiency": [
          {
            "metric": "max_ppl_cell_regression_pct",
            "op": "le",
            "value": 1,
            "unit": "percent",
            "rationale": "每格点估计非劣"
          },
          {
            "metric": "pooled_nll_delta_ci95_high",
            "op": "le",
            "value": 0.009950330853168092,
            "unit": "nats_per_token",
            "rationale": "log(1.01)非劣界"
          },
          {
            "metric": "mean_task_accuracy_gain_pp",
            "op": "ge",
            "value": -0.3,
            "unit": "percentage_points",
            "rationale": "点估计退化≤0.3pp"
          },
          {
            "metric": "mean_task_accuracy_delta_ci95_low_pp",
            "op": "ge",
            "value": -0.5,
            "unit": "percentage_points",
            "rationale": "CI非劣界"
          },
          {
            "metric": "fastest_accuracy_qualified_baseline_used",
            "op": "eq",
            "value": true,
            "unit": "boolean",
            "rationale": "不能仅与最慢旧实现比"
          },
          {
            "metric": "total_calibration_speedup_vs_qualified_baseline",
            "op": "ge",
            "value": 2,
            "unit": "ratio",
            "rationale": "含capture+solve+fusion+GPTQ"
          },
          {
            "metric": "peak_gpu_memory_ratio_vs_qualified_baseline",
            "op": "le",
            "value": 1,
            "unit": "ratio",
            "rationale": "峰值显存不增加"
          }
        ]
      }
    }
  ],
  "legacy_source_scope_policy": {
    "G0": "math_reference",
    "G1": "real_layer_panel",
    "G2": "full_model",
    "G3": "full_model",
    "G4": "full_model"
  }
}
